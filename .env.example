APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Dushanbe

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Каким прокси приложение доверяет заголовки X-Forwarded-* (audit I-1).
# Без этого per-IP rate limits (напр. submissions 10/мин) считаются по IP
# прокси — то есть на всех посетителей суммарно.
#   прод:      подсети/IP балансировщика и SSR-сервера Next.js, напр.
#              TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
#   локально:  REMOTE_ADDR (доверять прямому хопу lerd-nginx) или *
#   пусто:     прокси не доверяются (REMOTE_ADDR и есть клиент)
# nginx обязан прокидывать X-Forwarded-For ($proxy_add_x_forwarded_for) —
# см. deploy/nginx/ и DEPLOYMENT.md §2.10.
TRUSTED_PROXIES=
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# daily: один файл в сутки, хранится LOG_DAILY_DAYS (по умолчанию 14).
# single-файл на стенде без ротации раздулся до >1 ГБ (сотни тысяч повторов
# одной ошибки соединения с Redis) — см. OPS_RUNBOOK.md, «Журналы».
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
OBSERVABILITY_SLOW_REQUEST_MS=750
OBSERVABILITY_SLOW_QUERY_MS=250
OBSERVABILITY_API_SAMPLE_RATE=0.01

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=failover
DB_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_BLOCK_FOR=5
QUEUE_CRITICAL=critical
QUEUE_NOTIFICATIONS=notifications
QUEUE_REVALIDATION=revalidation
QUEUE_MONITOR_MAX=100

CACHE_STORE=failover
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CONNECT_TIMEOUT=1
# Должен быть БОЛЬШЕ REDIS_QUEUE_BLOCK_FOR: клиентский read-timeout срабатывает
# раньше серверного BLPOP — «read error on connection» на каждом пустом цикле
# воркера, и очереди после первой в списке молча голодают.
REDIS_READ_TIMEOUT=10
REDIS_RETRY_INTERVAL=100
REDIS_MAX_RETRIES=3

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Public API (api/v1) — CORS. Comma-separated origins of the Next.js public
# site allowed to call the API from the browser (forms, search).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# On-demand invalidation of the Next.js `cms` cache tag after public workflow
# transitions. URL should point to the frontend `/api/revalidate` endpoint.
FRONTEND_REVALIDATION_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATION_SECRET=
# Shared only between the Next.js server route and CMS RUM ingestion endpoint.
RUM_INGEST_SECRET=

# Disk used by spatie/laravel-medialibrary. Use `public` locally (run
# `php artisan storage:link`) and an S3-compatible disk in production so media
# is reachable cross-host by the public site.
MEDIA_DISK=public
# HTTPS origin or CDN base for immutable public derivatives. The `/storage`
# suffix is appended by Laravel.
MEDIA_PUBLIC_URL=http://localhost
# Draft/review/scheduled media must use a non-public disk with no web-server
# alias. Run `php artisan media:sync-visibility` once after deploying this.
MEDIA_PRIVATE_DISK=content_private
MEDIA_QUEUE=media
AVIFENC_BINARY=avifenc
QUEUE_CONVERSIONS_BY_DEFAULT=true
QUEUE_CONVERSIONS_AFTER_DB_COMMIT=true

# Set from the measured memory budget of the PHP-FPM pool. The production
# preflight rejects zero/unset capacity.
PHP_FPM_MAX_CHILDREN=0
OPCACHE_MEMORY_CONSUMPTION=192
OPCACHE_MAX_ACCELERATED_FILES=20000

BACKUP_ENABLED=false
BACKUP_PATH=
# Сколько последних копий хранить: копия включает оригиналы медиа и растёт
# вместе с библиотекой, поэтому без обрезки первым падает следующий бэкап.
BACKUP_KEEP=7
MYSQLDUMP_BINARY=mysqldump
MYSQL_BINARY=mysql
MEDIA_ORPHAN_GRACE_HOURS=24
# Сколько дней файл лежит в корзине перед окончательным удалением.
MEDIA_TRASH_GRACE_DAYS=30

# Isolated performance fixtures. Run `benchmark:seed` only with
# APP_ENV=benchmark and a database whose name contains "benchmark".
BENCHMARK_STORAGE_PATH=

# Development dataset replayed from the Committee's live sites by the
# Source*Seeder classes (fixtures live in database/seeders/data/source,
# refreshed with `php artisan khf:scrape-source`).
# Set to false to seed text only, without fetching covers and PDFs.
SEED_SOURCE_MEDIA=true
# Only needed where PHP has no CA bundle configured (curl.cainfo empty) —
# on Laragon, C:/laragon/etc/ssl/cacert.pem.
SEED_SOURCE_CA_BUNDLE=

# D-3: hotmeteor/spectator OpenAPI contract testing (tests/Feature/Api/
# OpenApiContractTest.php reads openapi.yaml at the repo root). These are
# only defaults for running spectator:validate/spectator:routes directly
# from the CLI — the test itself sets them via config() so it works
# regardless of .env.
SPEC_SOURCE=local
SPEC_PATH=./
SPECTATOR_PATH_PREFIX=api/v1

VITE_APP_NAME="${APP_NAME}"
