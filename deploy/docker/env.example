# Настройки стека КЧС (deploy/docker/compose.yml). Скопируйте в
# deploy/docker/.env и заполните; файл .env в git не попадает.
#
#   cp deploy/docker/env.example deploy/docker/.env && chmod 600 deploy/docker/.env
#
# Секреты генерируйте на сервере, не копируйте с компьютера разработчика:
#   APP_KEY:  echo "base64:$(openssl rand -base64 32)"
#   пароли:   openssl rand -hex 24

# --- Домены ----------------------------------------------------------------
# Сайт для граждан и CMS (панель + API). Пока домен временный — меняется
# здесь, после чего deploy.sh пересобирает сайт: адреса вшиваются в сборку.
# DNS обоих должен указывать на этот сервер ДО первого запуска: Caddy
# получает сертификаты Let's Encrypt автоматически.
SITE_DOMAIN=
CMS_DOMAIN=
# Почта для уведомлений Let's Encrypt о сертификатах.
ACME_EMAIL=

# --- Секреты ---------------------------------------------------------------
APP_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=
# Вебхук CMS → сайт (мгновенное обновление после публикации).
REVALIDATION_SECRET=
# Сайт → CMS: просмотры для «Статистики просмотров» и Web Vitals.
RUM_INGEST_SECRET=
# Ключ сервера сайта: его запросы к API CMS не упираются в лимит по IP.
SITE_API_KEY=

# --- Почта -----------------------------------------------------------------
# Сброс пароля сотрудников и письмо гражданину о новом этапе обращения.
# Почтовый сервер домена khf.tj. Пока не настроено — MAIL_MAILER=log: письма
# только в журнал, гражданам они не дойдут.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@khf.tj

# --- Оповещения дежурным (DEPLOYMENT.md §2.12) -----------------------------
TELEGRAM_ALERTS_BOT_TOKEN=
TELEGRAM_ALERTS_CHAT_ID=

# --- Ресурсы сервера -------------------------------------------------------
# Каталог резервных копий на хосте. Копию с него нужно регулярно увозить на
# другую площадку (DEPLOYMENT.md §8.5): копия на том же сервере — не копия.
BACKUP_DIR=/srv/khf/backups
BACKUP_KEEP=7
# Процессы PHP-FPM: проверьте `ops:capacity` после первого запуска.
PHP_FPM_MAX_CHILDREN=8
MYSQL_BUFFER_POOL=512M
REDIS_MAXMEMORY=256mb
LOG_LEVEL=info
# Доля посетителей, у которых сайт собирает Web Vitals.
RUM_SAMPLE_RATE=0.1

# --- Редко меняется --------------------------------------------------------
# Путь к репозиторию сайта относительно deploy/docker.
FRONT_SRC=../../../khf-site-front
# Внутренняя сеть стека; менять, только если пересекается с сетью сервера.
STACK_SUBNET=172.30.0.0/24
